<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#2A7DEEE0"/>
        </shape>
    </item>

    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#16263C"/>
            <stroke android:width="1dp" android:color="#7DEEE0"/>
        </shape>
    </item>

    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:angle="270" android:startColor="#1B4666" android:centerColor="#163852" android:endColor="#123046"/>
        </shape>
    </item>

</layer-list>
