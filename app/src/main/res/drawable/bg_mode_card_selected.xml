<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#3A2F12"/>
        </shape>
    </item>

    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#17150F"/>
            <stroke android:width="1dp" android:color="#D7B95A"/>
        </shape>
    </item>

    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient android:angle="270" android:startColor="#2F2411" android:centerColor="#1F1A12" android:endColor="#17140F"/>
        </shape>
    </item>

</layer-list>
