<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
            <solid android:color="#7C2E77A8" />
            <stroke android:width="2dp" android:color="#5FA8D8FF" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
            <gradient android:angle="270" android:startColor="#D25A6E9E" android:centerColor="#D26C86B8" android:endColor="#D289BCE8" />
            <stroke android:width="2dp" android:color="#B4E7FFFF" />
        </shape>
    </item>
</layer-list>
