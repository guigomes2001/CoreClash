<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF061B2F"
                android:centerColor="#FF103E63"
                android:endColor="#FF142B48" />
        </shape>
    </item>

    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape>
            <corners android:radius="10dp" />
            <gradient
                android:angle="225"
                android:startColor="#6639B8FF"
                android:endColor="#4D1674B8" />
            <stroke android:width="1dp" android:color="#6ECDFBFF" />
        </shape>
    </item>

    <item android:gravity="center" android:top="8dp">
        <shape android:shape="ring"
            android:innerRadius="18dp"
            android:thickness="2dp"
            android:useLevel="false">
            <solid android:color="#6646D6FF" />
        </shape>
    </item>

    <item android:gravity="center" android:top="8dp">
        <shape android:shape="ring"
            android:innerRadius="30dp"
            android:thickness="1dp"
            android:useLevel="false">
            <solid android:color="#44D7EEFF" />
        </shape>
    </item>

    <item android:gravity="center" android:top="8dp">
        <shape android:shape="oval">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#FFFF8A4C" />
        </shape>
    </item>

    <item android:left="40dp" android:top="18dp" android:width="8dp" android:height="8dp">
        <shape android:shape="oval"><solid android:color="#B3B1F2FF" /></shape>
    </item>
    <item android:left="86dp" android:top="40dp" android:width="6dp" android:height="6dp">
        <shape android:shape="oval"><solid android:color="#99E6FBFF" /></shape>
    </item>
    <item android:left="24dp" android:top="62dp" android:width="5dp" android:height="5dp">
        <shape android:shape="oval"><solid android:color="#99E6FBFF" /></shape>
    </item>

    <item android:gravity="bottom|start" android:left="12dp" android:bottom="12dp">
        <shape>
            <size android:width="88dp" android:height="24dp" />
            <corners android:radius="8dp" />
            <gradient
                android:angle="0"
                android:startColor="#AA0A2A46"
                android:endColor="#AA0C3E64" />
            <stroke android:width="1dp" android:color="#80C2EDFF" />
        </shape>
    </item>

    <item android:gravity="bottom|start" android:left="20dp" android:bottom="19dp">
        <shape>
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFF625A" />
        </shape>
    </item>

    <item android:gravity="bottom|start" android:left="42dp" android:bottom="19dp">
        <shape android:shape="oval">
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="#FF5DD4FF" />
        </shape>
    </item>

    <item android:gravity="bottom|start" android:left="64dp" android:bottom="19dp">
        <shape>
            <size android:width="10dp" android:height="10dp" />
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFF625A" />
        </shape>
    </item>
</layer-list>
