<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:startColor="#A61B1128"
                android:endColor="#D02A0F2A" />
        </shape>
    </item>
    <item android:gravity="bottom|start" android:left="10dp" android:bottom="8dp">
        <shape android:shape="oval">
            <size android:width="30dp" android:height="30dp" />
            <solid android:color="#E53935" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:right="12dp" android:bottom="10dp">
        <shape>
            <size android:width="24dp" android:height="24dp" />
            <solid android:color="#FFD54F" />
        </shape>
    </item>
</layer-list>
