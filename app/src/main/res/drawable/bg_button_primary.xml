<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFF2AE">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F7DF79"
                android:endColor="#F5C548" />
            <stroke
                android:width="1dp"
                android:color="#FFF7D36B" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
