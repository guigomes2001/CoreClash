<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D7DEEE0">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2C6980"
                android:endColor="#1F5168" />
            <stroke
                android:width="1dp"
                android:color="#9A7DEEE0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
