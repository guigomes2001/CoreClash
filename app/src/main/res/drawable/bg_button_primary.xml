<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#337DEEE0">

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#1A78D4C8" />
                </shape>
            </item>

            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#122238" />
                    <stroke android:width="1dp" android:color="#5A7DEEE0" />
                </shape>
            </item>

            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#1A3F60" android:centerColor="#15314F" android:endColor="#112942" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
