<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_cyber_glass" />

    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape>
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#2AE6F2FF"
                android:centerColor="#1A1A2F4A"
                android:endColor="#2A0A1327" />
            <stroke
                android:width="1dp"
                android:color="#40D7ECFF" />
        </shape>
    </item>
</layer-list>
