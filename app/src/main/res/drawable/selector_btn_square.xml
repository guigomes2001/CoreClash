<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#226D28D9">

    <item>
        <shape android:shape="oval">

            <gradient
                android:angle="270"
                android:startColor="#2C0B30"
                android:endColor="#111827" />

            <stroke
                android:width="3dp"
                android:color="#6D28D9" />

            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
        </shape>
    </item>
</ripple>

