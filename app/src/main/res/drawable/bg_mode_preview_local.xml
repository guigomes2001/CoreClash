            <corners android:radius="8dp" />
            <gradient android:angle="0" android:startColor="#16344D" android:endColor="#12253D" />
            <stroke android:width="1dp" android:color="#5A7DEEE0" />
        </shape>
    </item>

    <item android:gravity="bottom|center_horizontal" android:bottom="22dp" android:left="-26dp" android:width="12dp" android:height="12dp" android:drawable="@drawable/ic_square_outline" />
