<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#447DEEE0">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#16344D"
                android:endColor="#12253D" />
            <stroke
                android:width="1dp"
                android:color="#6A7DEEE0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
