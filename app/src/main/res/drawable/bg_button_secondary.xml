<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#5548C8FF">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#22A8F4"
                android:endColor="#3B5BFF" />
            <stroke
                android:width="1dp"
                android:color="#5CB8FFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
