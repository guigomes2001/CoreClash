<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3367E8F9">

    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#22D3EE"
                        android:endColor="#0EA5E9" />
                    <stroke
                        android:width="2dp"
                        android:color="#88A5F3FC" />
                    <corners android:radius="16dp" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#AA1D1B4B"
                        android:endColor="#CC16143C" />
                    <stroke
                        android:width="2dp"
                        android:color="#40818CF8" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
