<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFA06DFF" android:endColor="#FF56E2FF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF6EE7FF" android:endColor="#FF9D8BFF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#E0D9FFFF"/>
        </shape>
    </item>
</selector>
