<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#1A78D4C8"/>
        </shape>
    </item>

    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#122238"/>
            <stroke android:width="1dp" android:color="#5A7DEEE0"/>
        </shape>
    </item>

    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:angle="270"
                android:startColor="#16344D"
                android:centerColor="#12253D"
                android:endColor="#102032"/>
        </shape>
    </item>

</layer-list>
