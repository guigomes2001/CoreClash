<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2E7FA9D8">

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#17416666" />
                </shape>
            </item>

            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#122238" />
                    <stroke android:width="1dp" android:color="#4E8ABAE2" />
                </shape>
            </item>

            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient android:angle="270" android:startColor="#17304C" android:centerColor="#13263E" android:endColor="#102135" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
