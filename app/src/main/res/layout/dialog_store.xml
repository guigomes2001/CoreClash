<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_store_clash">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/store_dialog_title"
            android:textStyle="bold"
            android:textSize="24sp"
            android:textColor="#FFF3C4"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtStoreCoins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/store_coins_default"
            android:textColor="#D6E4FF"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_store_section">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/store_dialog_board_themes"
                android:textStyle="bold"
                android:textColor="#EAF2FF"/>

            <Button
                android:id="@+id/btnThemeRoyal"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_store_item"
                android:text="@string/store_dialog_theme_royal_price"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />

            <Button
                android:id="@+id/btnThemeVoid"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_store_item"
                android:text="@string/store_dialog_theme_void_price"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_store_section">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/store_dialog_symbol_styles"
                android:textStyle="bold"
                android:textColor="#EAF2FF"/>

            <Button
                android:id="@+id/btnStyleRune"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_store_item"
                android:text="@string/store_dialog_style_rune_price"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />

            <Button
                android:id="@+id/btnStyleFuture"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_store_item"
                android:text="@string/store_dialog_style_future_price"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBuyCoins"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_store_buy_button"
            android:text="@string/store_buy_coins"
            android:textStyle="bold"
            android:textColor="#1F1300" />
    </LinearLayout>
</ScrollView>
