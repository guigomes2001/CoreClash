<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark">

    <LinearLayout
        android:id="@+id/turnHudBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_cyber_glass"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/txtTurnHudNameX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/turn_hud_player_default"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#F8FAFC"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:layout_marginStart="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <ProgressBar
                android:id="@+id/progressTurnHudX"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FB7185"
                android:progressBackgroundTint="#22333455"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:text="@string/versus_center"
            android:textAllCaps="true"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/txtTurnHudNameO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/turn_hud_opponent_default"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#F8FAFC"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <ProgressBar
                android:id="@+id/progressTurnHudO"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#22D3EE"
                android:progressBackgroundTint="#22333455"/>
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/containerTriangle"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:background="@drawable/selector_btn_triangle"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        app:layout_constraintEnd_toStartOf="@id/boardContainer"
        android:layout_marginEnd="70dp"
        app:layout_constraintTop_toTopOf="@id/boardContainer"
        app:layout_constraintBottom_toBottomOf="@id/boardContainer">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_triangle_outline"
            android:tint="#D6B15B" />
    </FrameLayout>

    <View
        android:id="@+id/lineLeftConnector"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:background="#667DD3FC"
        app:layout_constraintStart_toEndOf="@id/containerTriangle"
        app:layout_constraintEnd_toStartOf="@id/boardContainer"
        app:layout_constraintTop_toTopOf="@id/containerTriangle"
        app:layout_constraintBottom_toBottomOf="@id/containerTriangle" />

    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="291dp"
        android:layout_height="291dp"
        android:background="@drawable/bg_cyber_glass"
        android:padding="6dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/turnHudBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.33">

        <GridLayout
            android:id="@+id/gridBoard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rowCount="3"
            android:columnCount="3"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds"
            android:layout_gravity="center" />

        <com.example.coreclash.view.VictoryLineView
            android:id="@+id/victoryLineView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/containerSquare"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:background="@drawable/selector_btn_square"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        app:layout_constraintStart_toEndOf="@id/boardContainer"
        android:layout_marginStart="70dp"
        app:layout_constraintTop_toTopOf="@id/boardContainer"
        app:layout_constraintBottom_toBottomOf="@id/boardContainer">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_square_outline"
            android:tint="#6D28D9" />
    </FrameLayout>

    <View
        android:id="@+id/lineRightConnector"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:background="#667DD3FC"
        app:layout_constraintStart_toEndOf="@id/boardContainer"
        app:layout_constraintEnd_toStartOf="@id/containerSquare"
        app:layout_constraintTop_toTopOf="@id/containerSquare"
        app:layout_constraintBottom_toBottomOf="@id/containerSquare" />



    

    

    <FrameLayout
        android:id="@+id/homeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_bg"
        android:elevation="92dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtHomeWallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text=""
                android:visibility="invisible"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlay"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_play"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/on_accent"
                    android:background="@drawable/bg_btn_primary"
                    android:backgroundTint="@null"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOnline"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_quick_match"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary"
                    android:backgroundTint="@null"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnStore"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/btn_store"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:textColor="#E2E8F0"
                        android:background="@drawable/bg_btn_ghost"
                        android:backgroundTint="@null"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSettings"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/btn_settings"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:textColor="#E2E8F0"
                        android:background="@drawable/bg_btn_ghost"
                        android:backgroundTint="@null"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/modeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone"
        android:elevation="94dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/modeCard"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_modal_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_title"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mode_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnModeCasual"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_mode_casual"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:letterSpacing="0.01"
                    android:background="@drawable/selector_btn_mode"
                    android:backgroundTint="@null"
                    android:textColor="@color/selector_mode_text"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnModeRanked"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/btn_mode_ranked"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:letterSpacing="0.01"
                    android:background="@drawable/selector_btn_mode"
                    android:backgroundTint="@null"
                    android:textColor="@color/selector_mode_text"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnModeCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/btn_back"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/accent"
                    android:background="@drawable/bg_btn_text"
                    android:backgroundTint="@null"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnModeConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="32dp"
                    android:text="@string/btn_ok"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:textColor="@color/on_accent"
                    android:background="@drawable/bg_btn_primary"
                    android:backgroundTint="@null"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/storeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/surface_bg"
        android:elevation="96dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/storeScreen"
            android:layout_width="640dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp"
            android:background="@drawable/bg_store_clash">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_store"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="26sp"/>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnStoreClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_close"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/btn_close"
                    android:background="@drawable/bg_icon_button"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtStoreCoinsFull"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/store_coins_default"
                android:textSize="14sp"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/store_section_themes"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:background="@drawable/bg_store_section">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_store_preview">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="X O"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="@string/store_theme_royal"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnThemeRoyal"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="72dp"
                            android:paddingHorizontal="18dp"
                            android:text="180"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_store_item"
                            android:backgroundTint="@null"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:background="@drawable/bg_store_section">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_store_preview">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="✦ ⬡"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#E9D5FF"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="@string/store_theme_void"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnThemeVoid"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="72dp"
                            android:paddingHorizontal="18dp"
                            android:text="220"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_store_item"
                            android:backgroundTint="@null"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/store_section_styles"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:background="@drawable/bg_store_section">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_store_preview">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="✦ ◉"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#BAE6FD"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="@string/store_style_rune"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnStyleRune"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="72dp"
                            android:paddingHorizontal="18dp"
                            android:text="140"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_store_item"
                            android:backgroundTint="@null"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:background="@drawable/bg_store_section">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_store_preview">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="⬡"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#BAE6FD"/>
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="@string/store_style_future"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnStyleFuture"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minWidth="72dp"
                            android:paddingHorizontal="18dp"
                            android:text="160"
                            android:textAllCaps="false"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_store_item"
                            android:backgroundTint="@null"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBuyCoins"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/store_buy_coins"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/on_accent"
                android:background="@drawable/bg_store_buy_button"
                android:backgroundTint="@null"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/storeTransitionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="99dp"
        android:background="#E60A1024">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0.95">

            <TextView
                android:id="@+id/txtCurtainTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X  O  △  ▢"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="#FFF3C4"/>

            <TextView
                android:id="@+id/txtCurtainMiddle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="△  X  ▢  O"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#D6E4FF"/>

            <TextView
                android:id="@+id/txtCurtainBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="▢  O  X  △"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/versusOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6111827"
        android:visibility="gone"
        android:elevation="95dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_cyber_glass">

            <View
                android:id="@+id/viewVersusStripeTop"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#66FBBF24" />

            <TextView
                android:id="@+id/txtVersusMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#33475569"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/mode_casual_label"
                android:textAllCaps="true"
                android:textColor="#E2E8F0"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtVersusCenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/versus_match_title_default"
                android:textColor="#F8FAFC"
                android:textStyle="bold"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtVersusX"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/versus_you"
                    android:textColor="#FB7185"
                    android:textStyle="bold"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:text="@string/versus_center"
                    android:textColor="#E5E7EB"
                    android:textStyle="bold"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/txtVersusO"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/versus_rival"
                    android:textColor="#67E8F9"
                    android:textStyle="bold"
                    android:textSize="26sp" />
            </LinearLayout>

            <View
                android:id="@+id/viewVersusStripeBottom"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="#5522D3EE" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/victoryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F20B1220"
        android:visibility="gone"
        android:elevation="100dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/victoryCard"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_modal_card"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtWinnerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/winner_default"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatsMoves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/stats_moves_default"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtStatsGhosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_ghosts_default"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtStatsReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/btn_rematch"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:letterSpacing="0.01"
                android:textColor="@color/on_accent"
                android:background="@drawable/bg_btn_primary"
                android:backgroundTint="@null"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNewMatch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_new_match"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:letterSpacing="0.01"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:backgroundTint="@null"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_back_to_menu"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:letterSpacing="0.01"
                android:textColor="@color/accent"
                android:background="@drawable/bg_btn_text"
                android:backgroundTint="@null"
                android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone"
        android:elevation="97dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/settingsCard"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_modal_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_settings"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="20dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChangeLanguage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_language"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="#E2E8F0"
                android:background="@drawable/bg_btn_ghost"
                android:backgroundTint="@null"
                android:layout_marginBottom="12dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGoogleLoginSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_link_google"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/on_accent"
                android:background="@drawable/bg_btn_primary"
                android:backgroundTint="@null"
                android:layout_marginBottom="16dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSettingsClose"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:minWidth="0dp"
                android:paddingHorizontal="20dp"
                android:text="@string/btn_close"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/accent"
                android:background="@drawable/bg_btn_text"
                android:backgroundTint="@null"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/dailyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone"
        android:elevation="98dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/dailyCard"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_modal_card"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_bonus_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/txtDailyBonusDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtDailyBonusCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDailyCollect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/btn_collect"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:textColor="@color/on_accent"
                android:background="@drawable/bg_btn_primary"
                android:backgroundTint="@null"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

