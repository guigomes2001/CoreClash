<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CORE CLASH"
        android:textColor="#FFF8E1"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.15"
        android:shadowColor="#664B2E83"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <FrameLayout
        android:id="@+id/containerTriangle"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/selector_btn_triangle"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="△"
            android:textSize="48sp"
            android:textColor="#FFECB3"
            android:layout_gravity="center"
            android:includeFontPadding="false" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cyber_glass"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/txtStatus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:id="@+id/gridBoard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rowCount="3"
            android:columnCount="3"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/containerSquare"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/selector_btn_square"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▢"
            android:textSize="40sp"
            android:textColor="#D1C4E9"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:translationY="-2dp"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/homeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9231835"
        android:elevation="92dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORE CLASH"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#FFF8E1"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#664B2E83"
                android:shadowRadius="20"
                android:shadowDx="0"
                android:shadowDy="0"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Escolha o modo e entre na arena"
                android:textColor="#E6DCC8"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeCasual"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:text="CASUAL"
                    android:textStyle="bold"
                    android:textColor="#3E2723"
                    android:backgroundTint="#FBC02D"/>

                <Button
                    android:id="@+id/btnModeRanked"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="RANQUEADO"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6A5ACD"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="320dp"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:text="JOGAR"
                android:textStyle="bold"
                android:textColor="#000000"
                android:backgroundTint="#FBC02D"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnStore"
                    android:layout_width="150dp"
                    android:layout_height="46dp"
                    android:text="LOJA"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4E3A73"/>

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="150dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:text="CONFIG"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4E3A73"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/versusOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9392F54"
        android:visibility="gone"
        android:elevation="95dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/txtVersusX"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="PLAYER X"
                android:textColor="#FF4444"
                android:textStyle="bold"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/txtVersusCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:text="VS"
                android:textColor="#FFF8E1"
                android:textStyle="bold"
                android:textSize="34sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/txtVersusO"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="PLAYER O"
                android:textColor="#EF9A9A"
                android:textStyle="bold"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/victoryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E0221B38"
        android:visibility="gone"
        android:elevation="100dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/victoryCard"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_cyber_glass"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtWinnerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="'X' VENCEU"
                android:textColor="#FFF8E1"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#66D1C4E9"
                android:layout_marginVertical="24dp" />

            <TextView
                android:id="@+id/txtStatsMoves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MOVIMENTOS: 0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:letterSpacing="0.1"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtStatsGhosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FANTASMAS: 0"
                android:textColor="#D1C4E9"
                android:textSize="16sp"
                android:layout_marginTop="12dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:text="REVANCHE"
                android:textColor="#000000"
                android:backgroundTint="#FBC02D"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="SAIR"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5E35B1"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="SAIR"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2C3448"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
