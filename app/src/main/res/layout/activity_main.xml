<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark">

    <LinearLayout
        android:id="@+id/turnHudBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_cyber_glass"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/txtTurnHudNameX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/turn_hud_player_default"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#E2E8F0"
                android:maxLines="1"
                android:ellipsize="end"/>

            <ProgressBar
                android:id="@+id/progressTurnHudX"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FB7185"
                android:progressBackgroundTint="#22333455"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="@string/versus_center"
            android:textAllCaps="true"
            android:textColor="#94A3B8"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/txtTurnHudNameO"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/turn_hud_opponent_default"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#E2E8F0"
                android:maxLines="1"
                android:ellipsize="end"/>

            <ProgressBar
                android:id="@+id/progressTurnHudO"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#22D3EE"
                android:progressBackgroundTint="#22333455"/>
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/containerTriangle"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:background="@drawable/selector_btn_triangle"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        app:layout_constraintEnd_toStartOf="@id/boardContainer"
        android:layout_marginEnd="70dp"
        app:layout_constraintTop_toTopOf="@id/boardContainer"
        app:layout_constraintBottom_toBottomOf="@id/boardContainer">

       <ImageView
	    android:layout_width="44dp"
	    android:layout_height="44dp"
	    android:layout_gravity="center"
	    android:src="@drawable/ic_triangle_outline"
	    android:tint="#D6B15B" />
    </FrameLayout>

    <View
        android:id="@+id/lineLeftConnector"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:background="#667DD3FC"
        app:layout_constraintStart_toEndOf="@id/containerTriangle"
        app:layout_constraintEnd_toStartOf="@id/boardContainer"
        app:layout_constraintTop_toTopOf="@id/containerTriangle"
        app:layout_constraintBottom_toBottomOf="@id/containerTriangle" />

    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="291dp"
        android:layout_height="291dp"
        android:background="@drawable/bg_cyber_glass"
        android:padding="6dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/turnHudBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.33">

        <GridLayout
            android:id="@+id/gridBoard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rowCount="3"
            android:columnCount="3"
            android:useDefaultMargins="false"
            android:alignmentMode="alignBounds"
            android:layout_gravity="center" />

        <com.example.coreclash.view.VictoryLineView
            android:id="@+id/victoryLineView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/containerSquare"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:background="@drawable/selector_btn_square"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp"
        app:layout_constraintStart_toEndOf="@id/boardContainer"
        android:layout_marginStart="70dp"
        app:layout_constraintTop_toTopOf="@id/boardContainer"
        app:layout_constraintBottom_toBottomOf="@id/boardContainer">

        <ImageView
	    android:layout_width="44dp"
	    android:layout_height="44dp"
	    android:layout_gravity="center"
	    android:src="@drawable/ic_square_outline"
	    android:tint="#6D28D9" />
    </FrameLayout>

    <View
        android:id="@+id/lineRightConnector"
        android:layout_width="8dp"
        android:layout_height="2dp"
        android:background="#667DD3FC"
        app:layout_constraintStart_toEndOf="@id/boardContainer"
        app:layout_constraintEnd_toStartOf="@id/containerSquare"
        app:layout_constraintTop_toTopOf="@id/containerSquare"
        app:layout_constraintBottom_toBottomOf="@id/containerSquare" />



    

    

    <FrameLayout
        android:id="@+id/homeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A1024"
        android:elevation="92dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_subtitle"
                android:textColor="#B8C6D8"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_cyber_glass">

                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_play"
                    android:drawableStart="@drawable/ic_swords_simple"
                    android:drawablePadding="10dp"
                    android:textStyle="bold"
                    android:textColor="#1F1300"
                    android:backgroundTint="#F7C948"
                    android:gravity="center_vertical|center_horizontal"/>

                <Button
                    android:id="@+id/btnOnline"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_quick_match"
                    android:drawableStart="@drawable/ic_flash_simple"
                    android:drawablePadding="10dp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:backgroundTint="#2563EB"
                    android:gravity="center_vertical|center_horizontal"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStore"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/btn_store"
                        android:drawableStart="@drawable/ic_store_stall"
                        android:drawablePadding="8dp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E3A5F"
                        android:gravity="center_vertical|center_horizontal"/>

                    <Button
                        android:id="@+id/btnSettings"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/btn_settings"
                        android:drawableStart="@drawable/ic_settings_gear"
                        android:drawablePadding="8dp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E3A5F"
                        android:gravity="center_vertical|center_horizontal"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/modeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#C4000000"
        android:visibility="gone"
        android:elevation="94dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/modeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_cyber_glass">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_title"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="#F8FAFC"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_subtitle"
                android:textColor="#94A3B8"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeCasual"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="@string/btn_mode_casual"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnModeRanked"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/btn_mode_ranked"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeCancel"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="@string/btn_back"
                    android:textStyle="bold"
                    android:textColor="#E0F2FE"
                    android:backgroundTint="#334155"/>

                <Button
                    android:id="@+id/btnModeConfirm"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/btn_ok"
                    android:textStyle="bold"
                    android:textColor="#041019"
                    android:backgroundTint="#F7C948"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>


    <FrameLayout
        android:id="@+id/storeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#0A1024"
        android:elevation="96dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/storeScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_store_clash">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_store"
                    android:textColor="#FFF3C4"
                    android:textStyle="bold"
                    android:textSize="24sp"/>

                <Button
                    android:id="@+id/btnStoreClose"
                    android:layout_width="54dp"
                    android:layout_height="40dp"
                    android:text="X"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#334155"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtStoreCoinsFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/store_coins_default"
                android:textColor="#D6E4FF"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="170dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_store_section"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/store_theme_royal"
                            android:textStyle="bold"
                            android:textColor="#EAF2FF"/>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_cyber_glass">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="X  O"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#F8FAFC"/>
                        </FrameLayout>

                        <Button
                            android:id="@+id/btnThemeRoyal"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="180"
                            android:textStyle="bold"
                            android:background="@drawable/bg_store_item"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="170dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_store_section"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/store_theme_void"
                            android:textStyle="bold"
                            android:textColor="#EAF2FF"/>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_marginTop="8dp"
                            android:background="#221A1024">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="✦  ⬡"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#E9D5FF"/>
                        </FrameLayout>

                        <Button
                            android:id="@+id/btnThemeVoid"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="220"
                            android:textStyle="bold"
                            android:background="@drawable/bg_store_item"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="170dp"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:background="@drawable/bg_store_section"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/store_styles_title"
                            android:textStyle="bold"
                            android:textColor="#EAF2FF"/>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:layout_marginTop="8dp"
                            android:background="#222A447A">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="✦ vs ◉"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="#BAE6FD"/>
                        </FrameLayout>

                        <Button
                            android:id="@+id/btnStyleRune"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/store_style_rune_price"
                            android:textStyle="bold"
                            android:background="@drawable/bg_store_item"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <Button
                android:id="@+id/btnStyleFuture"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="@string/store_style_future_price"
                android:textStyle="bold"
                android:background="@drawable/bg_store_item"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnBuyCoins"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="@string/store_buy_coins"
                android:textStyle="bold"
                android:textColor="#1F1300"
                android:background="@drawable/bg_store_buy_button"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/storeTransitionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="99dp"
        android:background="#E60A1024">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0.95">

            <TextView
                android:id="@+id/txtCurtainTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X  O  △  ▢"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="#FFF3C4"/>

            <TextView
                android:id="@+id/txtCurtainMiddle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="△  X  ▢  O"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#D6E4FF"/>

            <TextView
                android:id="@+id/txtCurtainBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="▢  O  X  △"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/versusOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111827"
        android:visibility="gone"
        android:elevation="95dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/txtVersusX"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/versus_you"
                android:textColor="#FF4444"
                android:textStyle="bold"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/txtVersusCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:text="@string/versus_center"
                android:textColor="#E5E7EB"
                android:textStyle="bold"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/txtVersusO"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/versus_rival"
                android:textColor="#67E8F9"
                android:textStyle="bold"
                android:textSize="30sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/victoryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1220"
        android:visibility="gone"
        android:elevation="100dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/victoryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_cyber_glass"
            android:orientation="vertical"
            android:layout_marginHorizontal="24dp"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtWinnerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/winner_default"
                android:textColor="#E5E7EB"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatsMoves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/stats_moves_default"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtStatsGhosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_ghosts_default"
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:drawableStart="@drawable/ic_swords_simple"
                android:drawablePadding="8dp"
                android:layout_marginTop="24dp"
                android:text="@string/btn_rematch"
                android:textColor="#041019"
                android:backgroundTint="#F7C948"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnNewMatch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:drawableStart="@drawable/ic_flash_simple"
                android:drawablePadding="8dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_new_match"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_back_to_menu"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                android:textStyle="bold"/>
        </LinearLayout>
    </FrameLayout>
    
    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D60A1024"
        android:visibility="gone"
        android:elevation="97dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/settingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/bg_cyber_glass"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_settings"
                android:textColor="#F8FAFC"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnChangeLanguage"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_language"
                android:textStyle="bold"
                android:textColor="#E0F2FE"
                android:backgroundTint="#1E3A5F"
                android:drawableStart="@drawable/ic_settings_gear" 
                android:drawablePadding="12dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnGoogleLoginSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_link_google"
                android:textStyle="bold"
                android:textColor="#1F1300"
                android:backgroundTint="#F7C948"
                android:drawableStart="@drawable/ic_flash_simple"
                android:drawablePadding="12dp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSettingsClose"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_close"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"/>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
