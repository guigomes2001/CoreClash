<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_modal_panel">

        <TextView
            android:id="@+id/txtProfileDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_title"
            android:textColor="#F8FAFC"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtProfileDialogTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_button_tertiary"
            android:textColor="#D7E9FF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/profile_ranked_title"
            android:textColor="#EAF2FF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_store_section">

            <TextView
                android:id="@+id/txtProfileStatSeason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E8F4FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProfileStatTier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#CDE2FB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtProfileStatMmr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CDE2FB"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtProfileStatRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CDE2FB"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/profile_name"
            android:textColor="#D8E9FF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/profile_name"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#EAF2FF"
            android:textColorHint="#8FAACA"
            android:background="@drawable/bg_button_tertiary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/profile_symbol_style"
            android:textColor="#D8E9FF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinnerProfileStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_tertiary"
            android:dropDownWidth="match_parent"
            android:popupBackground="@drawable/bg_modal_panel"
            android:spinnerMode="dropdown" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/profile_style_helper"
            android:textColor="#9EC3E8"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnProfileClose"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="98dp"
                android:background="@drawable/bg_button_tertiary"
                android:text="@string/btn_close"
                android:textAllCaps="false"
                android:textColor="#DDEBFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProfileSave"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="112dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/profile_save"
                android:textAllCaps="false"
                android:textColor="#04131F"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
