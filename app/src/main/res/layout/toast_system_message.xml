<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_panel"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/txtToastIcon"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fa_solid_900"
        android:gravity="center"
        android:text="@string/fa_bolt"
        android:textColor="#6EE7FF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtToastMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center_horizontal"
        android:maxWidth="240dp"
        android:maxLines="4"
        android:textAlignment="center"
        android:textColor="#EAF2FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="18dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

</LinearLayout>
