<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_modal_panel">

    <TextView
        android:id="@+id/txtPrivacyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/privacy_dialog_title"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.03"
        android:gravity="center" />

    <TextView
        android:id="@+id/txtPrivacyBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/privacy_dialog_message"
        android:textColor="#CFE8FF"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnPrivacyClose"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="96dp"
            android:text="@string/btn_close"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#DDEBFF"
            android:background="@drawable/bg_button_tertiary" />

        <Button
            android:id="@+id/btnPrivacyOpen"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="160dp"
            android:layout_marginStart="10dp"
            android:text="@string/privacy_dialog_open_policy"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#04131F"
            android:background="@drawable/bg_button_primary" />
    </LinearLayout>
</LinearLayout>
