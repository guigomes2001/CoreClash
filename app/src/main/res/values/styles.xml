<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text" />

    <style name="Text.CoreClash" parent="Text">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.CoreClash.Title" parent="Text.CoreClash">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/ds_title_size</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="Text.CoreClash.Subtitle" parent="Text.CoreClash">
        <item name="android:textColor">@color/ds_text_muted</item>
        <item name="android:textSize">@dimen/ds_subtitle_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.CoreClash.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_height">@dimen/ds_button_height</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#04131F</item>
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="Widget.CoreClash.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_height">@dimen/ds_button_height</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#EAF2FF</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <style name="Widget.CoreClash.Button.Tertiary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_height">@dimen/ds_button_height</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#DDEBFF</item>
        <item name="android:background">@drawable/bg_button_tertiary</item>
    </style>

</resources>
